# Nilai bawaan kiosk. Berkas ini IKUT di penyimpanan kode dan dibaca lebih
# dulu; apa pun yang ditulis di .env akan menimpanya.
#
# Isinya hanya setelan yang BUKAN rahasia. Karena semuanya sudah benar di sini,
# PC baru tidak perlu diatur apa-apa selain dua isian rahasia yang ditanyakan
# sekali lewat halaman penyiapan di peramban.

# Alamat server undangan. Menentukan dari mana daftar member ditarik DAN ke
# mana QR di struk menunjuk. Jangan diisi AUTO di PC acara.
BASE_URL=https://undangan.opsjobs.id

PORT=4000
UNDANGAN_PORT=5010

# Printer.
#
# PRINTER_HOST sengaja DIKOSONGKAN. Kiosk menyapu jaringan lokal sendiri,
# menemukan printer yang menjawab sebagai ESC/POS, lalu memakainya dan
# mengingatnya. Alamat yang ditulis tangan di sini justru menjadi salah begitu
# kiosk dipindahkan ke jaringan lain — dan gejalanya, "printer tidak konek",
# tidak menunjuk ke sebabnya sama sekali.
#
# Isi hanya bila penyapuan tidak boleh dipakai dan alamatnya sudah pasti.
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_NAME=
PRINTER_WIDTH=80
QR_MODULE=10

# Acara.
NAMA_ACARA=HUT EWALK 17-TH
