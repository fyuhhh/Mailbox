# Salin ke .env lalu sesuaikan.  Jangan commit .env.

# ---- Halaman undangan -------------------------------------------------------
# Tanpa slash di akhir. Huruf besar disengaja: URL bersifat case-insensitive
# pada skema dan host, dan QR mode alfanumerik hanya menerima A-Z 0-9 $%*+-./: —
# huruf kecil memaksa mode byte yang membuat QR jauh lebih rapat dan sulit
# discan dari kertas thermal 58mm.
#
# AUTO = pakai alamat LAN komputer ini secara otomatis. Biarkan AUTO selama
# menguji di jaringan lokal, supaya folder ini bisa disalin ke komputer mana
# pun tanpa disunting. Ganti ke alamat VPS saat acara sungguhan.
BASE_URL=AUTO
# BASE_URL=HTTPS://UNDANGAN.OPSJOBS.ID

# Port server undangan, dipakai hanya ketika BASE_URL=AUTO.
UNDANGAN_PORT=5010

# Kunci yang sama dengan SYNC_SECRET di server undangan.
SYNC_SECRET=ganti-dengan-kunci-acak-panjang

# ---- Printer ----------------------------------------------------------------
# --- Pilih SALAH SATU cara menghubungi printer ---
#
# (a) Lewat jaringan — isi PRINTER_HOST. Ini jalur paling sederhana: byte
#     ESC/POS dikirim langsung ke port 9100 printer, tanpa driver, tanpa
#     antrian sistem yang bisa menampung pekerjaan diam-diam untuk printer
#     yang sudah mati. Printer dan PC kiosk HARUS satu jaringan.
# PRINTER_HOST=192.168.1.102
# PRINTER_PORT=9100
#
# (b) Lewat USB — kosongkan PRINTER_HOST dan isi PRINTER_NAME.
# macOS : nama antrian CUPS  ->  lihat dengan `lpstat -p`
# Windows: nama share printer ->  Printer Properties > Sharing > Share name
PRINTER_NAME=TECH_CLA58

# Lebar kertas: 58 atau 80 (mm). Salah isi di sini membuat QR dihitung
# terhadap lebar yang keliru dan struk tercetak melenceng.
PRINTER_WIDTH=58

# Ukuran modul QR di struk (1-16). Makin besar makin gampang discan,
# tapi harus tetap muat di lebar kertas.
QR_MODULE=10

# Set ke 1 untuk mengembangkan tanpa printer: struk dibuang ke kiosk/data/*.bin
PRINTER_DRYRUN=0

# Nama perangkat USB untuk memeriksa apakah printer benar-benar tercolok.
# Biarkan kosong: nilainya diambil sendiri dari device-uri antrian. Isi manual
# hanya bila pemeriksaan itu meleset.
# PRINTER_USB_NAME=CLA58

# ---- Acara ------------------------------------------------------------------
NAMA_ACARA=HUT PERUSAHAAN
PORT=4000

# Sandi untuk membuka halaman Persiapan Acara (daftar kode voucher).
# WAJIB diisi — tanpa ini halaman tersebut tidak bisa dibuka sama sekali.
SANDI_PETUGAS=
