# Salin ke .env di server:  /opt/undangan/.env
# Kunci ini HARUS sama persis dengan SYNC_SECRET di kiosk.
SYNC_SECRET=ganti-dengan-kunci-acak-panjang

PORT=5010

# Biarkan kosong di VPS: Nginx yang menghadap internet, server ini cukup
# mendengarkan loopback. Isi 0.0.0.0 HANYA saat menguji di jaringan lokal
# agar ponsel bisa menjangkaunya langsung tanpa Nginx.
# LISTEN_HOST=0.0.0.0

# ---- Isi undangan -----------------------------------------------------------
NAMA_PERUSAHAAN=Nama Perusahaan
JUDUL_ACARA=Ulang Tahun ke-10
TANGGAL_ACARA=Sabtu, 20 September 2026
JAM_ACARA=18.00 WIB - selesai
LOKASI_ACARA=Ballroom Hotel Contoh
ALAMAT_ACARA=Jl. Contoh No. 1, Jakarta
PETA_URL=https://maps.google.com/?q=-6.2,106.8

# Waktu mulai acara dalam format ISO, untuk hitung mundur di halaman.
MULAI_ISO=2026-09-20T18:00:00+07:00
